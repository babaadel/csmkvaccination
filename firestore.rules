rules_version = '2';
// Règles Firestore – Suivi vaccination Kankossa
// À coller dans : Firebase → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // membre actif rattaché à un établissement
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().get('active', true) != false;
    }
    function mySid() { return me().sid; }
    function curMonth() { return get(/databases/$(database)/documents/config/main).data.cur; }

    // ---- Propriétaire / premier compte ----
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/owner)
                    && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    // ---- Superviseurs ----
    match /admins/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && !exists(/databases/$(database)/documents/meta/owner)
                        && existsAfter(/databases/$(database)/documents/meta/owner));
      allow update: if isAdmin();
      allow delete: if isAdmin() && resource.data.get('owner', false) != true;
    }

    // ---- Membres ----
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ---- Configuration (mois, établissements, seuil) ----
    match /config/{doc} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
    }

    // ---- Dépôt Moughataa ----
    match /depot/{month} {
      allow read, write: if isAdmin();
    }

    // ---- Mouvements des établissements : data/{mois}_{établissement} ----
    match /data/{docId} {
      // le membre ne peut modifier ni le stock début (d = report, dl = donné par le dépôt) ni les entrées (e)
      // (écrit de façon compacte : Firestore limite le nombre d'expressions évaluées par requête)
      function same(n, o) { return n.get('e', 0) == o.get('e', 0) && n.get('d', 0) == o.get('d', 0) && n.get('dl', 0) == o.get('dl', 0); }
      function allSame(n, o) {
        return same(n.get('HepB', {}), o.get('HepB', {})) && same(n.get('BCG', {}), o.get('BCG', {}))
            && same(n.get('VPO', {}), o.get('VPO', {})) && same(n.get('HEXA', {}), o.get('HEXA', {}))
            && same(n.get('Pneumo', {}), o.get('Pneumo', {})) && same(n.get('Rota', {}), o.get('Rota', {}))
            && same(n.get('RR', {}), o.get('RR', {})) && same(n.get('PVH', {}), o.get('PVH', {}))
            && same(n.get('Td', {}), o.get('Td', {}));
      }
      function entriesUnchanged() { return allSame(request.resource.data, resource == null ? {} : resource.data); }
      function onlyAntigens() {
        return request.resource.data.keys().hasOnly(['HepB','BCG','VPO','HEXA','Pneumo','Rota','RR','PVH','Td']);
      }

      allow read: if isAdmin() || (isMember() && docId.split('_').size() == 2 && docId.split('_')[1] == mySid());
      allow create, update: if isAdmin()
                            || (isMember() && docId == curMonth() + '_' + mySid()
                                && onlyAntigens() && entriesUnchanged());
      allow delete: if isAdmin();
    }

    // ---- Commandes ----
    match /orders/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.sid == mySid());
      allow create: if isAdmin()
                    || (isMember() && request.resource.data.sid == mySid()
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.status == 'pending');
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isMember() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }
  }
}
